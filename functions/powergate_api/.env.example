# Set these in Catalyst console > Serverless > Functions > powergate_api > Environment Variables
# (or in catalyst-config.json "env_variables" for local serve only — never commit real secrets).

# --- Zoho OAuth (Self Client or server-based client in the BMI Zoho account that owns the Creator app)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Data-centre specific. .com = US, .ca = Canada, .eu, .in, .com.au
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
CREATOR_API_URL=https://www.zohoapis.com

# --- Creator app
CREATOR_OWNER=
CREATOR_APP=

# --- Catalyst roles (Authentication > User Management > Roles)
CSP_ROLE_NAME=CSP
CLIENT_ROLE_NAME=Client
# Optional extra guard: CSP users must have an email on this domain. Empty = off.
CSP_EMAIL_DOMAIN=bickertmanagement.com

# --- Business rules
# true = CSP can only approve tasks whose estimate is <= the project's approval threshold.
CSP_APPROVAL_REQUIRES_THRESHOLD=true
# Must match the Creator app's date format (Settings > General).
CREATOR_DATE_FORMAT=dd-MMM-yyyy

# true = log Creator request/response summaries (never tokens). Turn off in production.
DEBUG_LOGS=false
